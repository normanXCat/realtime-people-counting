# Poids de modèles et binaires (non versionnés : empreinte SHA-256 enregistrée
# dans config/pipeline.yaml et vérifiée au démarrage par src/main.py)
src/models/yolov4.weights
*.weights
models/
*.pt
*.onnx
*.engine

# Vidéos d'exemple et jeux de données locaux : volumineux et non libres de droits.

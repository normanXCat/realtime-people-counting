# Poids de modèles et binaires (non versionnés : empreinte SHA-256 enregistrée
# dans config/pipeline.yaml et vérifiée au démarrage par src/main.py)
src/models/yolov4.weights
*.weights
models/
*.pt
*.onnx
*.engine

# Vidéos d'exemple et jeux de données locaux : volumineux et non libres de droits.
# Les vidéos annotées et les journaux d'événements ne doivent jamais être poussés
# (voir docs/politique_confidentialite.md).
test/
data/videos/
# Images extraites pour l'annotation de vérité terrain : mêmes personnes que
# les vidéos ci-dessus, donc même régime de confidentialité. Le fichier
# tests/fixtures/ground_truth_*.json y renvoie (champ « image ») mais reste
# lisible sans elles ; elles sont conservées hors dépôt par la personne
# responsable (voir docs/correctif_occlusion.md §12.1).
annotation/
results/
# Relevés par seconde et propositions de rattachement NON agrégés : ils
# portent les boîtes englobantes des personnes des vidéos ci-dessus, donc le
# même régime de confidentialité. Seule la version agrégée (compteurs par
# seconde, sans tableau « persons ») est versionnée.
tests/fixtures/trace_baseline_fort_occ4.jsonl
tests/fixtures/gt_matching_*.json

# Médias et fragments temporaires
*.mp4
*.avi
*.mkv
*.mov
*.wmv
*.flv
*.webm
*.part

# Environnement, caches et artefacts d'outils
.venv/
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/
.DS_Store
